relationship fact_transaction_date_key_to_dim_date
	fromColumn: fact_transaction.date_key
	toColumn: dim_date.date_key

relationship fact_transaction_sender_account_to_dim_account
	fromColumn: fact_transaction.sender_account
	toColumn: dim_account.account_id

relationship fact_transaction_receiver_account_to_dim_account
	isActive: false
	fromColumn: fact_transaction.receiver_account
	toColumn: dim_account.account_id

relationship fact_alert_alert_date_key_to_dim_date
	fromColumn: fact_alert.alert_date_key
	toColumn: dim_date.date_key

relationship fact_alert_rule_id_to_dim_rule
	fromColumn: fact_alert.rule_id
	toColumn: dim_rule.rule_id

relationship fact_alert_customer_key_to_dim_customer
	fromColumn: fact_alert.customer_key
	toColumn: dim_customer.customer_key

relationship fact_alert_case_id_to_fact_case
	fromColumn: fact_alert.case_id
	toColumn: fact_case.case_id
