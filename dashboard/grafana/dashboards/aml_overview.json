    {
      "id": 10,
      "title": "Rule precision and recall",
      "type": "barchart",
      "description": "Account level, against synthetic ground-truth labels. ANY = any rule.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aml-postgres"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 16,
        "h": 8
