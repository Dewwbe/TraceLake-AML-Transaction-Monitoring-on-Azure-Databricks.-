      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aml-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT rule_id AS rule, ROUND(precision::numeric, 3) AS precision, ROUND(recall::numeric, 3) AS recall FROM gold.mart_rule_performance WHERE run_id = (SELECT run_id FROM gold.mart_rule_performance ORDER BY computed_at DESC LIMIT 1) ORDER BY rule_id",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "gradientMode": "none"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3b82f6"
          },
          "max": 1,
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "precision"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3b82f6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "recall"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8b5cf6"
                }
              }
            ]
          }
        ]
