          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(r.rule_name, 'Sanctions screening') AS rule, count(*) AS alerts FROM gold.fact_alert a LEFT JOIN gold.dim_rule r ON r.rule_id = a.rule_id GROUP BY 1 ORDER BY 2 DESC",
