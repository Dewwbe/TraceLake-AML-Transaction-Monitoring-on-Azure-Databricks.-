# Local mode (default): parquet "tables" under AML_BASE_PATH, local Spark
AML_STORE=parquet
AML_BASE_PATH=./data/lake
AML_LANDING_PATH=./data/landing
AML_CHECKPOINT_PATH=./data/checkpoints
AML_SOURCE_PROFILE=saml_d
AML_USE_AUTOLOADER=false

# Databricks mode: Delta tables in Unity Catalog, landing in a Unity Catalog volume
# AML_STORE=delta
# AML_CATALOG=aml
# AML_LANDING_PATH=/Volumes/aml/landing/files
# AML_CHECKPOINT_PATH=/Volumes/aml/landing/checkpoints
# AML_USE_AUTOLOADER=true
